# Complete CIPC-Agent Environment Configuration
# Database Configuration
DATABASE_URL=postgresql://postgres:password@localhost:5432/cipc_agent

# Temporal Configuration
TEMPORAL_HOST_PORT=localhost:7233
TEMPORAL_ADDRESS=127.0.0.1:7233
TEMPORAL_UI_PORT=8233

# Server Configuration
PORT=3000
NODE_PORT=3000
INTERNAL_API_KEY=cipc-agent-secure-key-2024

# External APIs
OPENAI_API_KEY=your-openai-api-key
AISENSY_API_KEY=your-aisensy-api-key
CIPC_API_KEY=your-cipc-api-key

# Payment Configuration
PAYFAST_MERCHANT_ID=your-payfast-merchant-id
PAYFAST_MERCHANT_KEY=your-payfast-merchant-key

# Application URLs
BASE_URL=http://localhost:3000
NODE_SERVER_URL=http://localhost:3000

# AI Configuration
AI_MODEL=gpt-4
AI_TEMPERATURE=0.7

# Typebot Configuration
TYPEBOT_WEBHOOK_SECRET=your-typebot-webhook-secret

# Security
JWT_SECRET=your-jwt-secret-key
ENCRYPTION_KEY=your-encryption-key
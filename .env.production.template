# CIPC-Agent Production Environment Template
# Copy to .env and fill in your production values

# Server Configuration
NODE_ENV=production
PORT=8080
FRONTEND_URL=https://your-domain.com

# Database
DATABASE_URL=postgresql://username:password@host:5432/database_name
REDIS_URL=redis://localhost:6379

# API Keys
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here
TYPEBOT_API_KEY=your_typebot_api_key_here

# CIPC Credentials
CIPC_USERNAME=your_cipc_username
CIPC_PASSWORD=your_cipc_password

# WhatsApp Integration
AISENSY_API_KEY=your_aisensy_api_key_here
AISENSY_WEBHOOK_SECRET=your_webhook_secret_here
AISENSY_WHATSAPP_NUMBER=your_whatsapp_number
WHATSAPP_NUMBER=your_whatsapp_number

# Payment Integration
PAYFAST_MERCHANT_ID=your_merchant_id_here
PAYFAST_MERCHANT_KEY=your_merchant_key_here
PAYFAST_PASSPHRASE=your_passphrase_here

# Security (Generate strong random values)
SESSION_SECRET=generate_strong_random_secret_here
JWT_SECRET=generate_strong_jwt_secret_here
INTERNAL_API_KEY=generate_strong_internal_api_key_here

# Compliance
POPIA_RETENTION_DAYS=365
DATA_ENCRYPTION_KEY=your_encryption_key_here

# Monitoring
LOG_LEVEL=info
SENTRY_DSN=your_sentry_dsn_here

# Python Path
PYTHON_PATH=python

# Base URL
BASE_URL=https://your-domain.com

# Temporal
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_UI_PORT=8233

# Node Server
NODE_PORT=8080
# CIPC-Agent Environment Configuration Template
# Copy to .env and fill in your actual values

# Server Configuration
NODE_ENV=production
PORT=8080
FRONTEND_URL=https://your-domain.com

# Database
DATABASE_URL=postgresql://<username>:<password>@<host>:5432/<database_name>
REDIS_URL=redis://localhost:6379

# API Keys
GEMINI_API_KEY=<your_gemini_api_key>
OPENAI_API_KEY=<your_openai_api_key>
TYPEBOT_API_KEY=<your_typebot_api_key>

# CIPC Credentials
CIPC_USERNAME=<your_cipc_username>
CIPC_PASSWORD=<your_cipc_password>

# WhatsApp Integration
AISENSY_API_KEY=<your_aisensy_api_key>
AISENSY_WEBHOOK_SECRET=<your_webhook_secret>
AISENSY_WHATSAPP_NUMBER=<your_whatsapp_number>
WHATSAPP_NUMBER=<your_whatsapp_number>

# Payment Integration
PAYFAST_MERCHANT_ID=<your_merchant_id>
PAYFAST_MERCHANT_KEY=<your_merchant_key>
PAYFAST_PASSPHRASE=<your_passphrase>

# Security
SESSION_SECRET=<generate_strong_session_secret>
JWT_SECRET=<generate_strong_jwt_secret>
INTERNAL_API_KEY=<generate_internal_api_key>

# Compliance
POPIA_RETENTION_DAYS=2555
DATA_ENCRYPTION_KEY=<your_encryption_key>

# Monitoring
LOG_LEVEL=info
SENTRY_DSN=<your_sentry_dsn>

# Python Path
PYTHON_PATH=python

# Base URL
BASE_URL=https://your-domain.com

# Temporal
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_UI_PORT=8233

# Node Server
NODE_PORT=8080
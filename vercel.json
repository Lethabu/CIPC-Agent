{
  "version": 2,
  "buildCommand": "npm run build",
  "installCommand": "npm install && cd client && npm install",
  "outputDirectory": "client/dist",
  "framework": "vite",

  "routes": [
    {
      "src": "/api/(.*)",
      "dest": "/api/$1"
    },
    {
      "src": "/(.*)",
      "dest": "/index.html"
    }
  ]
}
